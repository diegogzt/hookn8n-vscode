{
  "name": "n8n-webhook-chat",
  "displayName": "N8N Webhook Chat",
  "description": "N8N webhook-powered chat assistant with AI capabilities for VS Code",
  "version": "1.0.1",
  "publisher": "dgtovar",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegogzt/hookn8n-vscode.git"
  },
  "homepage": "https://github.com/diegogzt/hookn8n-vscode#readme",
  "bugs": {
    "url": "https://github.com/diegogzt/hookn8n-vscode/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "assistant",
    "chatbot",
    "programming",
    "code-help",
    "n8n",
    "webhook",
    "automation",
    "rag",
    "artificial-intelligence"
  ],
  "galleryBanner": {
    "color": "#4239c8",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:chatbot.start",
    "onCommand:chatbot.showInSidebar",
    "onView:chatbotView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chatbot.start",
        "title": "Open N8N Webhook Chat",
        "category": "N8N Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "chatbot.showInSidebar",
        "title": "N8N Webhook Chat",
        "icon": "$(robot)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "chatbotView",
          "name": "N8N Webhook Chat",
          "when": "true",
          "icon": "$(robot)",
          "contextualTitle": "N8N Webhook Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "chatbotView",
        "contents": "Welcome to N8N Webhook Chat! 🤖\n\nN8N webhook-powered chat assistant for developers.\n\n[Open N8N Chat](command:chatbot.start)\n\n[⚙️ Configure N8N Webhook](command:chatbot.start)\n\nFeatures:\n• N8N webhook integration\n• Real-time chat responses\n• Modern interface\n• Custom workflow automation\n• Persistent history"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chatbot.start",
          "when": "view == chatbotView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chatbot.start",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4",
    "webpack": "^5.58.2",
    "webpack-cli": "^4.9.1"
  }
}
